{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=printjobs.db"
  },
  "BarTender": {
    "DefaultIntegrationMode": "FileDrop",
    "Hotfolder": {
      "LocalOutboxPath": "./outbox",
      "TargetPath": "\\\\SERVER\\BarTender\\Hotfolder",
      "FileExtension": ".xml",
      "UseAtomicMove": true
    },
    "Http": {
      "EndpointUrl": "http://localhost:5160/api/print",
      "AuthMode": "None",
      "AuthToken": "",
      "AuthUsername": "",
      "AuthPassword": "",
      "TimeoutSeconds": 30
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "DelaySeconds": [1, 3, 5]
    },
    "Templates": [
      { "Name": "Etichetta Pericolo GHS", "Path": "C:\\BarTender\\Templates\\GHS_HazardLabel.btw" },
      { "Name": "Etichetta Pericolo Piccola", "Path": "C:\\BarTender\\Templates\\GHS_HazardLabel_Small.btw" }
    ],
    "Printers": [
      "Zebra ZT410",
      "Zebra ZD620",
      "CAB A4+"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bartender-web-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
